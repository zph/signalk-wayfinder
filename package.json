{
  "name": "signalk-wayfinder",
  "version": "0.8.0",
  "description": "Fail-closed sail passage planning for Signal K",
  "author": "Kristian Wiklund",
  "homepage": "https://github.com/zph/signalk-wayfinder",
  "repository": {
    "type": "git",
    "url": "https://github.com/zph/signalk-wayfinder.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-weather"
  ],
  "signalk": {
    "displayName": "Sail Wayfinder",
    "appIcon": "./wr-icon-128px.png",
    "screenshots": [
      "screenshot2.jpg",
      "route-to-route-demo.png"
    ],
    "requires": [
      "signalk-polar-performance-plugin"
    ]
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/inject-buildinfo.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "tsc",
    "prepare-land-data": "python3 scripts/prepare-land-data.py",
    "build-hires-land-data:podman": "bash scripts/build-hires-land-data-podman.sh",
    "test": "tsx --test 'src/lib/__tests__/**/*.test.ts'",
    "benchmark:rust-sidecar": "tsc && tsx scripts/benchmark-rust-sidecar.ts",
    "test:arm64": "bash scripts/test-arm64.sh",
    "lint": "eslint src/",
    "format": "prettier --write src/ public/index.html",
    "format:check": "prettier --check src/ public/index.html"
  },
  "files": [
    "dist/",
    "public/",
    "scripts/build-hires-land-data-podman.sh",
    "scripts/prepare-land-data.py",
    "wr-icon-128px.png",
    "route-to-route-demo.png",
    "screenshot2.jpg"
  ],
  "peerDependencies": {
    "@signalk/server-api": ">=2.28.0"
  },
  "optionalDependencies": {
    "@kristianwiklund/wr-gdal-linux-arm64": "3.12.3",
    "@kristianwiklund/wr-gdal-linux-x64": "3.12.3"
  },
  "dependencies": {
    "@kristianwiklund/wr-land-data": "1.0.0",
    "@mapbox/vector-tile": "^2.0.4",
    "express": "^4.21.0",
    "gdal-async": "^3.9.0",
    "jsts": "^2.12.1",
    "leaflet": "^1.9.4",
    "pbf": "^4.0.1"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/jsts": "^0.17.24",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
